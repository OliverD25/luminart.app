{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminart-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "luminart.app", "custom_domain": true }
  ],
  "build": {
    "command": "node scripts/build.mjs"
  }
}
