{
  "name": "luminart.app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "deploy:www": "wrangler deploy -c redirects/wrangler.jsonc -e www",
    "deploy:telemetrix": "wrangler deploy -c redirects/wrangler.jsonc -e telemetrix",
    "deploy:all": "npm run deploy && npm run deploy:www && npm run deploy:telemetrix",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
