// Redirect-only hostnames. Each one is its own Worker, named "luminart-<label>" (www.luminart.app is
// "luminart-www"). A product with a real site of its own lives in sites/<label>/ instead.
// "vars" are not inherited from the top level, so every environment sets its own.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "luminart-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "env": {
    "www": {
      "name": "luminart-www",
      "routes": [{ "pattern": "www.luminart.app", "custom_domain": true }],
      "vars": {
        "TARGET": "https://luminart.app",
        "STATUS": "301",
        "KEEP_PATH": "true"
      }
    }
  }
}
