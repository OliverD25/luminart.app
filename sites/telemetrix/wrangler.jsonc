{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luminart-telemetrix",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
